<Window x:Class="StratoDomainDDNSChanger.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DDNS Updater 0.6" Width="1000" Height="800" MinWidth="900" MinHeight="620"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme/AppTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="#272537" CornerRadius="15"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
   <TextBlock Text="DDNS Updater" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,18,10">
    <Button Content="—" Width="34" MinWidth="34" Height="30" Background="#0c1524" Click="Minimize_Click"/>
    <Button Content="X" Width="34" MinWidth="34" Height="30" Background="DarkRed" Click="Close_Click" Margin="0"/>
   </StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Home">
    <Grid Margin="18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock x:Name="RunStatus" Text="Stopped" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="IPv4Status" Text="IPv4: not checked" Margin="0,12,0,4"/>
      <TextBlock x:Name="IPv6Status" Text="IPv6: not checked" TextWrapping="Wrap"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Text="HOSTNAME UPDATES" FontSize="12" Foreground="#F0F1F4" Margin="0,24,0,8"/>
     <ListBox x:Name="StatusList" Grid.Row="2" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,12">
       <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F0F1F4" Margin="0,4,0,0"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
      <Button x:Name="StartButton" Content="Start" Click="Start_Click"/>
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
      <Button x:Name="CheckButton" Content="Check now" Click="Check_Click"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Config">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
     <TextBlock Text="Provider" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
      <TextBlock Text="Update URL" VerticalAlignment="Center"/><TextBox x:Name="EndpointBox" Grid.Column="1" Margin="0,2"/>
      <TextBlock Text="Username" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
      <TextBlock Text="Password" Grid.Row="2" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" Padding="8,5" Margin="0,2"/>
     </Grid>
     <TextBlock Text="Domains and subdomains" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <TextBlock Text="Enter full hostnames, such as example.com or game.example.com. Enable DynDNS for each hostname at your provider first." TextWrapping="Wrap" Foreground="#F0F1F4" Margin="0,0,0,10"/>
     <DataGrid x:Name="HostsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="110" MaxHeight="220" RowHeight="34">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="300"/>
       <DataGridComboBoxColumn x:Name="ModeColumn" Header="Addresses to publish" SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,10"><Button Content="Add hostname" Click="Add_Click"/><Button Content="Remove selected" Click="Remove_Click"/></StackPanel>
     <TextBlock Text="IPv4Only skips IPv6 updates; it does not delete an existing AAAA record. Manage existing DNS records at your provider." TextWrapping="Wrap" Foreground="#F0F1F4"/>
     <Expander Header="IP lookup services" Margin="0,14,0,10"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="IPv4 lookup URL"/><TextBox x:Name="IPv4Box" Margin="0,4,0,8"/>
      <TextBlock Text="IPv6 lookup URL"/><TextBox x:Name="IPv6Box" Margin="0,4,0,0"/>
     </StackPanel></Expander>
     <CheckBox x:Name="AutoStartBox" Content="Start monitoring when this app opens" Margin="0,5,0,16"/>
     <Button x:Name="SaveButton" Content="Save settings" Background="DarkOliveGreen" Click="Save_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Foreground="#F0F1F4" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="Checks every 5 minutes · Settings stored outside the app folder · Password protected by Windows" FontSize="12" Foreground="#F0F1F4" Margin="220,10,20,0" TextWrapping="Wrap"/>
 </Grid></Border>
</Window>
